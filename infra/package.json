{
  "name": "@fitroom/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "synth": "cdk synth --no-version-reporting --no-notices -q",
    "synth:ci": "tsx scripts/synth-ci.ts",
    "diff": "cdk diff --no-version-reporting --no-notices",
    "serve:prod-like": "tsx ../scripts/serve-prod-like.mjs",
    "csp:probe": "tsx e2e/csp-probe.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "lint:workflows": "tsx scripts/validate-workflows.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "aws-cdk": "^2.1145.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
